  PublicKey mint = 2;
  PublicKey bonding_curve = 3;
  PublicKey metadata = 4;
  PublicKey creator = 5;
}
    
message SetMetaplexCreatorEvent {
  SetMetaplexCreatorEventAccounts accounts = 1;
  SetMetaplexCreatorEventArgs args = 2;
}
    
message SetParamsEventAccounts {
  repeated PublicKey remaining_accounts = 1;
}
    
message SetParamsEventArgs {
  uint64 initial_virtual_token_reserves = 1;
  uint64 initial_virtual_sol_reserves = 2;
  uint64 initial_real_token_reserves = 3;
  uint64 final_real_sol_reserves = 4;
  uint64 token_total_supply = 5;
  uint64 fee_basis_points = 6;
  PublicKey withdraw_authority = 7;
  bool enable_migrate = 8;
  uint64 pool_migration_fee = 9;
  uint64 creator_fee_basis_points = 10;
  repeated PublicKey fee_recipients = 11;
  int64 timestamp = 12;
  PublicKey set_creator_authority = 13;
  PublicKey admin_set_creator_authority = 14;
}
    
message SetParamsEvent {
  SetParamsEventAccounts accounts = 1;
  SetParamsEventArgs args = 2;
}
    
message SyncUserVolumeAccumulatorEventAccounts {
  repeated PublicKey remaining_accounts = 1;
}
    
message SyncUserVolumeAccumulatorEventArgs {
  PublicKey user = 1;
  uint64 total_claimed_tokens_before = 2;
  uint64 total_claimed_tokens_after = 3;
  int64 timestamp = 4;
}
    
message SyncUserVolumeAccumulatorEvent {
  SyncUserVolumeAccumulatorEventAccounts accounts = 1;
  SyncUserVolumeAccumulatorEventArgs args = 2;
}
    
message TradeEventAccounts {
  repeated PublicKey remaining_accounts = 1;
}
    
message TradeEventArgs {
  PublicKey mint = 1;
  uint64 sol_amount = 2;
  uint64 token_amount = 3;
  bool is_buy = 4;
  PublicKey user = 5;
  int64 timestamp = 6;
  uint64 virtual_sol_reserves = 7;
  uint64 virtual_token_reserves = 8;
  uint64 real_sol_reserves = 9;
  uint64 real_token_reserves = 10;
  PublicKey fee_recipient = 11;
  uint64 fee_basis_points = 12;
  uint64 fee = 13;
  PublicKey creator = 14;
  uint64 creator_fee_basis_points = 15;
  uint64 creator_fee = 16;
  bool track_volume = 17;
  uint64 total_unclaimed_tokens = 18;
  uint64 total_claimed_tokens = 19;
  uint64 current_sol_volume = 20;
  int64 last_update_timestamp = 21;
  string ix_name = 22;
  bool mayhem_mode = 23;
  uint64 cashback_fee_basis_points = 24;
  uint64 cashback = 25;
}
    
message TradeEvent {
  TradeEventAccounts accounts = 1;
  TradeEventArgs args = 2;
}
    
message UpdateGlobalAuthorityEventAccounts {
  repeated PublicKey remaining_accounts = 1;
}
    
message UpdateGlobalAuthorityEventArgs {
  PublicKey global = 1;
  PublicKey authority = 2;
  PublicKey new_authority = 3;
  int64 timestamp = 4;
}
    
message UpdateGlobalAuthorityEvent {
  UpdateGlobalAuthorityEventAccounts accounts = 1;
  UpdateGlobalAuthorityEventArgs args = 2;
}
    
message UpdateMayhemVirtualParamsEventAccounts {
  repeated PublicKey remaining_accounts = 1;
}
    
message UpdateMayhemVirtualParamsEventArgs {
  int64 timestamp = 1;
  PublicKey mint = 2;
  uint64 virtual_token_reserves = 3;
  uint64 virtual_sol_reserves = 4;
  uint64 new_virtual_token_reserves = 5;
  uint64 new_virtual_sol_reserves = 6;
  uint64 real_token_reserves = 7;
  uint64 real_sol_reserves = 8;
}
    
message UpdateMayhemVirtualParamsEvent {
  UpdateMayhemVirtualParamsEventAccounts accounts = 1;
  UpdateMayhemVirtualParamsEventArgs args = 2;
}
    
message PumpFunAccount {
  oneof account {
    BondingCurve bonding_curve = 1;
    FeeConfig fee_config = 2;
    Global global = 3;
    GlobalVolumeAccumulator global_volume_accumulator = 4;
    SharingConfig sharing_config = 5;
    UserVolumeAccumulator user_volume_accumulator = 6;
  }
}
message Instructions {
  oneof instruction {
    AdminSetCreator admin_set_creator = 1;
    AdminSetIdlAuthority admin_set_idl_authority = 2;
    AdminUpdateTokenIncentives admin_update_token_incentives = 3;
    Buy buy = 4;
    BuyExactSolIn buy_exact_sol_in = 5;
    ClaimCashback claim_cashback = 6;
    ClaimTokenIncentives claim_token_incentives = 7;
    CloseUserVolumeAccumulator close_user_volume_accumulator = 8;
    CollectCreatorFee collect_creator_fee = 9;
    Create create = 10;
    CreateV2 create_v2 = 11;
    DistributeCreatorFees distribute_creator_fees = 12;
    ExtendAccount extend_account = 13;
    GetMinimumDistributableFee get_minimum_distributable_fee = 14;
    InitUserVolumeAccumulator init_user_volume_accumulator = 15;
    Initialize initialize = 16;
    Migrate migrate = 17;
    MigrateBondingCurveCreator migrate_bonding_curve_creator = 18;
    Sell sell = 19;
    SetCreator set_creator = 20;
    SetMayhemVirtualParams set_mayhem_virtual_params = 21;
    SetMetaplexCreator set_metaplex_creator = 22;
    SetParams set_params = 23;
    SetReservedFeeRecipients set_reserved_fee_recipients = 24;
    SyncUserVolumeAccumulator sync_user_volume_accumulator = 25;
    ToggleCashbackEnabled toggle_cashback_enabled = 26;
    ToggleCreateV2 toggle_create_v2 = 27;
    ToggleMayhemMode toggle_mayhem_mode = 28;
    UpdateGlobalAuthority update_global_authority = 29;
  }
}
message ProgramEvents {
  oneof event {
    AdminSetCreatorEvent admin_set_creator_event = 1;
    AdminSetIdlAuthorityEvent admin_set_idl_authority_event = 2;
    AdminUpdateTokenIncentivesEvent admin_update_token_incentives_event = 3;
    ClaimCashbackEvent claim_cashback_event = 4;
    ClaimTokenIncentivesEvent claim_token_incentives_event = 5;
    CloseUserVolumeAccumulatorEvent close_user_volume_accumulator_event = 6;
    CollectCreatorFeeEvent collect_creator_fee_event = 7;
    CompleteEvent complete_event = 8;
    CompletePumpAmmMigrationEvent complete_pump_amm_migration_event = 9;
    CreateEvent create_event = 10;
    DistributeCreatorFeesEvent distribute_creator_fees_event = 11;
    ExtendAccountEvent extend_account_event = 12;
    InitUserVolumeAccumulatorEvent init_user_volume_accumulator_event = 13;
    MigrateBondingCurveCreatorEvent migrate_bonding_curve_creator_event = 14;
    MinimumDistributableFeeEvent minimum_distributable_fee_event = 15;
    ReservedFeeRecipientsEvent reserved_fee_recipients_event = 16;
    SetCreatorEvent set_creator_event = 17;
    SetMetaplexCreatorEvent set_metaplex_creator_event = 18;
    SetParamsEvent set_params_event = 19;
    SyncUserVolumeAccumulatorEvent sync_user_volume_accumulator_event = 20;
    TradeEvent trade_event = 21;
    UpdateGlobalAuthorityEvent update_global_authority_event = 22;
    UpdateMayhemVirtualParamsEvent update_mayhem_virtual_params_event = 23;
  }
}
message ProgramEventOutput {
  optional Instructions instruction = 1;
  repeated ProgramEvents program_events = 2;
}
